
# Spotify (optional — falls back to the static list in src/lib/data.ts)
# `npm run spotify:token` produces the refresh token and prints which scopes
# were actually granted. The widget needs both user-read-currently-playing and
# user-read-recently-played; a token missing the second still shows the current
# track, so the gap looks like an empty listening history rather than an error.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Contact form (required — without all three, the form shows an error and the
# message is never sent). https://resend.com/api-keys
RESEND_API_KEY=

# Must be on a domain verified in Resend. NOT the visitor's address: Resend
# signs with the sending domain's key, and a From pointing elsewhere is what
# SPF/DMARC exist to reject. The visitor goes in Reply-To instead.
CONTACT_FROM="Portfolio <hi@erikwijnbladh.com>"

# Where the mail actually lands. Point this at an inbox that gets read — if it
# is an alias, make sure the alias forwards somewhere you check.
CONTACT_TO=hello@erikwijnbladh.com
