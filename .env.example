
# Chat (required for the "Ask" tab in the dock — without it the card loads and
# every question comes back with "the chat isn't switched on right now").
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Spotify (optional — falls back to the static list in src/lib/data.ts).
# The widget needs user-read-currently-playing and user-read-recently-played;
# the chat also needs user-top-read to answer questions about favorite or top
# artists and tracks from real listening data.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Email delivery. The API key is shared by the contact form and inbound webhook.
# https://resend.com/api-keys
RESEND_API_KEY=

# Resend inbound webhook. Copy the signing secret from the webhook details page
# after registering /api/webhooks/resend for the email.received event.
RESEND_WEBHOOK_SECRET=

# The public address shown by the site. Its domain must be verified in Resend.
PUBLIC_EMAIL=hello@erikwijnbladh.com

# Private destination for contact-form messages and received-email forwarding.
# Keep the real value in the deployment environment; do not commit it here.
FORWARD_TO=

# Chat logs (optional). Every conversation in the "Ask" tab is saved as one
# private JSON file under chats/ in a Vercel Blob store. Create a *private*
# store in the Vercel dashboard (Storage → Blob) and connect it to the project;
# that sets this for you. Without it nothing is saved.
BLOB_READ_WRITE_TOKEN=
