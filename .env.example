
# Spotify (optional — falls back to the static list in src/lib/data.ts)
# `npm run spotify:token` produces the refresh token and prints which scopes
# were actually granted. The widget needs both user-read-currently-playing and
# user-read-recently-played; a token missing the second still shows the current
# track, so the gap looks like an empty listening history rather than an error.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Redis (optional — where the accumulated listening history lives)
#
# Without it the list only holds what one Spotify request returns, which for
# this account is the current track and nothing else. With it, each poll adds
# whatever is playing to a rolling list of the last ten, and that list outlives
# the request that saw it.
#
# Either naming works: Vercel KV sets the KV_ pair, the marketplace Redis
# integrations set the UPSTASH_ pair. Both speak the same REST API.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
